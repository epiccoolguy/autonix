prefix_rule(pattern=["/bin/zsh", "-lc", "gh pr merge 146 --rebase --match-head-commit 677b733$(git rev-parse HEAD | cut -c8-)"])
prefix_rule(pattern=["gh", "pr", ["create", "edit", "list", "merge", "ready", "view"]])
prefix_rule(pattern=["git", "merge", "--ff-only"])
prefix_rule(pattern=["git", "rebase", "origin/master"])
prefix_rule(pattern=["git", "worktree", "add"])
prefix_rule(pattern=["git", ["add", "apply", "commit", "fetch", "pull", "push"]])
prefix_rule(pattern=["nix", "develop"])
prefix_rule(pattern=["nix", "eval"])
prefix_rule(pattern=["nix", "flake", "check"])
