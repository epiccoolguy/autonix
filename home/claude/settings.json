{
  "cleanupPeriodDays": 90,
  "env": {
    "KUBECONFIG": "/Users/miguel/.kube/admin.mlzw.config"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(go:*)",
      "Bash(gofmt:*)",
      "Bash(goimports:*)",
      "Bash(golangci-lint:*)",
      "Bash(npm:*)",
      "Bash(pnpm:*)",
      "Bash(npx:*)",
      "Bash(pnpx:*)",
      "Bash(deno:*)",
      "Bash(tsc:*)",
      "Bash(eslint:*)",
      "Bash(python3:*)",
      "Bash(pytest:*)",
      "Bash(pyright:*)",
      "Bash(uv:*)",
      "Bash(uvx:*)",
      "Bash(pipx:*)",
      "Bash(podman:*)",
      "Bash(docker:*)",
      "Bash(nix:*)",
      "Bash(nixfmt:*)",
      "Bash(nixfmt-tree:*)",
      "Bash(make:*)",
      "Bash(kubectl:*)",
      "Bash(argocd:*)",
      "Bash(direnv:*)",
      "Bash(op item get:*)",
      "mcp__github",
      "mcp__kubernetes",
      "mcp__grafana",
      "mcp__argocd",
      "WebFetch",
      "WebSearch"
    ],
    "ask": [
      "Bash(gh repo delete:*)",
      "Bash(gh secret:*)",
      "Bash(gh auth:*)",
      "mcp__github__delete_file",
      "mcp__github__push_files",
      "mcp__github__create_or_update_file"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "fallbackModel": [
    "opus",
    "sonnet"
  ],
  "disableClaudeAiConnectors": true,
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "refreshInterval": 60
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true
  },
  "feedbackSurveyRate": 0,
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "advisorModel": "opus",
  "awaySummaryEnabled": true,
  "askUserQuestionTimeout": "10m",
  "autoUpdatesChannel": "stable",
  "skipWorkflowUsageWarning": false,
  "theme": "auto",
  "switchModelsOnFlag": false,
  "agentPushNotifEnabled": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "GitHub collaboration: authoring or updating issues, creating or updating pull requests, and merging pull requests (gh CLI or GitHub MCP tools)",
      "GitOps deploy flow for all environments including prd: pushing feature branches, opening PRs against master, merging to master, re-pinning overlays/acc and overlays/prd image digests, promoting releases to prd, creating vX.Y.Z release tags"
    ],
    "soft_deny": [
      "$defaults"
    ],
    "environment": [
      "$defaults",
      "Organization: personal setup of Miguel Lo-A-Foe (software engineer); primary use: software development and GitOps-based Kubernetes operations",
      "Source control: github.com/epiccoolguy and all repos under it",
      "Trusted internal domains: *.mlzw.dev",
      "Key internal services: Argo CD at argocd.mlzw.dev, Grafana at grafana.mlzw.dev, the mlzw Kubernetes cluster accessed via ~/.kube/admin.mlzw.config",
      "Sensitive remote targets: prd-suffixed namespaces, apps, and contexts on the mlzw cluster"
    ]
  }
}
